{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carrel",
  "version": "0.1.0-alpha.1",
  "identifier": "net.carrel.reader",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve --config Trunk.toml --no-default-features --features csr",
      "cwd": "."
    },
    "beforeBuildCommand": {
      "script": "python3 ../../scripts/build_frontend.py",
      "cwd": "."
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Carrel",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 24 },
        "backgroundColor": "#173d32"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../COPYRIGHT": "COPYRIGHT",
      "../../THIRD_PARTY.md": "THIRD_PARTY.md",
      "frontend/public/licenses/": "licenses/"
    },
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
